# The foundation runs without database/auth/storage/payment credentials.
APP_ENV=local

# Fixture-backed Lani Moku storefront prototype at /order/lani-moku-grill.
# Sample data only; ignored in production. Remove or blank to hide it.
DEMO_STOREFRONT_ENABLED=1

# Configure only when a dedicated Restaurant target and roles are approved.
# Set all three together. DATABASE_ENV must match APP_ENV.
# Never use production or Bulwark connections in local/test/preview.
# DATABASE_URL=postgresql://app_role:REPLACE_ME@RESTAURANT_HOST/restaurant?sslmode=require
# DATABASE_ENV=local
# DATABASE_PROJECT_ID=RESTAURANT_PROJECT_ID
